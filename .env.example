# Public site origin used for canonical URLs, sitemap, and robots.
# Production default in code is https://trekroots.com if unset.
NEXT_PUBLIC_SITE_URL=https://trekroots.com

# Cloudinary (public — safe for browser URL building)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Cloudinary (server-only — never expose to the client)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Enquiry email delivery (server-only). Without RESEND_API_KEY the forms fall
# back to WhatsApp instead of sending mail.
RESEND_API_KEY=your_resend_api_key
# Must be a domain verified in Resend. Defaults to Resend's sandbox sender.
ENQUIRY_FROM_EMAIL=TrekRoots <info@trekroots.com>
# Defaults to info@trekroots.com.
ENQUIRY_TO_EMAIL=info@trekroots.com

# Optional. Protects POST /api/media/upload. Leave unset to keep the route
# disabled in production. Prefer `pnpm media:upload` for bulk uploads.
MEDIA_UPLOAD_SECRET=

# Sanity (public — project + dataset only; safe for browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=w00xdoog
NEXT_PUBLIC_SANITY_DATASET=production

# Optional. Server-only Viewer token for draft/preview mode — never expose to the client.
# SANITY_API_READ_TOKEN=

# Optional. Seconds between ISR revalidation for Sanity blog fetches (default 60).
# SANITY_REVALIDATE_SECONDS=60

